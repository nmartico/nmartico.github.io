{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatterplot showing horsepower and miles per gallons for various cars.",
  "title": {
    "text": "Power and fuel consumption",
    "font": "serif",
    "fontSize": 20
  },
  "data": {"url": "https://raw.githubusercontent.com/nmartico/nmartico.github.io/refs/heads/main/cars.json"},
  "width": 300,
  "height": 300,
  "mark": {
    "type": "point",
    "color": "orangered",
    "size": 100,
    "fill": "blue",
    "opacity": 0.3
  },
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative", "title": "HorsePower"},
    "y": {
      "field": "Miles_per_Gallon",
      "type": "quantitative",
      "title": "Miles per Gallon"
    }
  },
  "config": {}
}