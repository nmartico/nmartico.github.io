{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly CPI bars, YoY line and COVID-19 event markers",
  "data": {
    "url": "https://raw.githubusercontent.com/nmartico/nmartico.github.io/refs/heads/main/CPIUKBeefandveal.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Date": "date",
        "CPI": "number",
        "YoY": "number",
        "COVID-19": "number"
      }
    }
  },
  "title": "Beef and Veal CPI in the UK",
  "width": "container",
  "height": 400,
  "layer": [
    {
      "mark": {"type": "bar", "color": "#72bef741", "opacity": 0.75},
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": "Date (monthly)",
            "format": "%Y",
            "tickCount": "year",
            "labelAngle": 270
          }
        },
        "y": {
          "field": "CPI",
          "type": "quantitative",
          "axis": {
            "title": "CPI",
            "orient": "left",
            "titleColor": "#2878B5",
            "labelColor": "#2878B5"
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": "#dd4a10",
        "interpolate": "linear",
        "point": false
      },
      "encoding": {
        "x": {"field": "Date", "type": "temporal"},
        "y": {
          "field": "YoY",
          "type": "quantitative",
          "axis": {
            "title": "YoY (%)",
            "orient": "right",
            "titleColor": "#b82200",
            "labelColor": "#b82200"
          }
        },
        "tooltip": [
          {
            "field": "Date",
            "type": "temporal",
            "title": "Date",
            "format": "%b %Y"
          },
          {
            "field": "YoY",
            "type": "quantitative",
            "title": "YoY (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {"filter": "isValid(datum['COVID-19']) && datum['COVID-19'] != 0"}
      ],
      "mark": {
        "type": "rule",
        "color": "#000000",
        "strokeWidth": 1,
        "strokeDash": [5, 3]
      },
      "encoding": {
        "x": {"field": "Date", "type": "temporal"},
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {"domain": [0, 1], "nice": false},
          "axis": null
        },
        "y2": {"datum": 1},
        "tooltip": [
          {
            "field": "Date",
            "type": "temporal",
            "title": "Event date",
            "format": "%b %Y"
          },
          {
            "field": "COVID-19",
            "type": "quantitative",
            "title": "COVID-19 indicator"
          }
        ]
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}},
  "config": {"view": {"stroke": null}, "axis": {"grid": false}}
}